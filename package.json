{
  "name": "ronork",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/build-blog-data.js",
    "build": "preact build --prerenderUrls prerender-urls.json",
    "postbuild": "node -e \"require('fs').copyFileSync('build/index.html', 'build/404.html')\"",
    "serve": "preact build --prerenderUrls prerender-urls.json && preact serve",
    "dev": "preact watch",
    "lint": "eslint src --ext .js,.jsx"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.0.4",
    "preact-cli": "^3.5.1"
  },
  "dependencies": {
    "preact": "^10.29.1",
    "preact-helmet": "^4.0.0-alpha-3",
    "preact-router": "^3.2.1",
    "react-social-icons": "^5.15.0"
  },
  "eslintConfig": {
    "extends": "eslint-config-preact",
    "env": {
      "browser": true
    }
  },
  "browserslist": [
    ">0.5%",
    "not dead",
    "not op_mini all"
  ]
}
